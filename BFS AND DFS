from collections import deque

# Define the social network graph
graph = {
    "Alice": ["Charlie", "David"],
    "Charlie": ["Alice", "Emma"],
    "David": ["Alice", "Emma", "Fred"],
    "Emma": ["Charlie", "David", "Bob"],
    "Fred": ["David", "Bob"],
    "Bob": ["Emma", "Fred"]
}

# BFS Implementation
def bfs(start, goal):
    visited = []
    queue = deque([[start]])  # queue stores paths

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node not in visited:
            visited.append(node)

            if node == goal:
                return path, visited

            for neighbor in graph[node]:
                new_path = list(path)
                new_path.append(neighbor)
                queue.append(new_path)
    return None, visited

# DFS Implementation
def dfs(start, goal):
    visited = []
    stack = [[start]]  # stack stores paths

    while stack:
        path = stack.pop()
        node = path[-1]

        if node not in visited:
            visited.append(node)

            if node == goal:
                return path, visited

            # Push neighbors in alphabetical order
            for neighbor in sorted(graph[node], reverse=True):
                new_path = list(path)
                new_path.append(neighbor)
                stack.append(new_path)
    return None, visited

# Run simulations
bfs_path, bfs_visited = bfs("Alice", "Bob")
dfs_path, dfs_visited = dfs("Alice", "Bob")

print("BFS Path:", bfs_path)
print("BFS Visited Order:", bfs_visited)
print("DFS Path:", dfs_path)
print("DFS Visited Order:", dfs_visited)
